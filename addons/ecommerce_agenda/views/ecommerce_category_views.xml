<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── VISTAS ECOMMERCE.CATEGORY ──────────────────────────── -->

    <record id="ecommerce_category_view_list" model="ir.ui.view">
        <field name="name">ecommerce.category.list</field>
        <field name="model">ecommerce.category</field>
        <field name="arch" type="xml">
            <list string="Categorías de Tienda" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="product_count" string="Productos" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ecommerce_category_view_form" model="ir.ui.view">
        <field name="name">ecommerce.category.form</field>
        <field name="model">ecommerce.category</field>
        <field name="arch" type="xml">
            <form string="Categoría de Tienda">
                <sheet>
                    <widget name="web_ribbon" title="Archivado"
                            bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ej: Electrónica, Servicios, Accesorios..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_count" string="Total de productos"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1"
                                placeholder="Describe brevemente esta categoría..."/>
                    </group>
                    <notebook>
                        <page string="Productos" name="products">
                            <field name="product_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="list_price" string="Precio"/>
                                    <field name="ecommerce_featured" string="Destacado"/>
                                    <field name="active" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── ACCIÓN ──────────────────────────────────────────── -->

    <record id="ecommerce_category_action" model="ir.actions.act_window">
        <field name="name">Categorías de Tienda</field>
        <field name="res_model">ecommerce.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera categoría de tienda
            </p>
            <p>
                Las categorías agrupan tus productos en la tienda web interactiva.
                Los clientes podrán filtrar por categoría al explorar el catálogo.
            </p>
        </field>
    </record>

    <!-- ── ACCESOS AL MODELO (Definidos aquí para robustez durante migraciones) ── -->

    <record id="access_ecommerce_category_public" model="ir.model.access">
        <field name="name">ecommerce.category.public</field>
        <field name="model_id" ref="model_ecommerce_category"/>
        <field name="group_id" ref="base.group_public"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="access_ecommerce_category_user" model="ir.model.access">
        <field name="name">ecommerce.category.user</field>
        <field name="model_id" ref="model_ecommerce_category"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ── MENÚ: Inventario → Productos → Categorías de Tienda ── -->

    <menuitem id="ecommerce_menu_categories"
              name="Categorías de Tienda"
              parent="stock.menu_stock_inventory_control"
              action="ecommerce_category_action"
              sequence="15"/>

</odoo>
