<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ecommerce" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ecommerce</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tienda Web" string="Tienda Web" name="ecommerce_agenda">
                    <block title="Configuración de la Tienda Web" id="ecommerce_settings">
                        <setting string="Identidad de la Tienda" help="Nombre comercial público para el encabezado de la tienda.">
                            <field name="ecommerce_store_name" placeholder="Mi Tienda"/>
                        </setting>

                        <setting string="Número de WhatsApp" help="Número con código internacional para recibir pedidos por WhatsApp (ej: 584121234567).">
                            <field name="ecommerce_whatsapp_number" placeholder="Ej: 584121234567"/>
                        </setting>

                        <setting string="Instagram / Redes Sociales" help="Usuario de Instagram visible en la tienda.">
                            <field name="ecommerce_instagram_handle" placeholder="@mitienda"/>
                        </setting>

                        <setting string="Ubicación de la Tienda" help="Ciudad o dirección de despacho mostrada en la cabecera/pie.">
                            <field name="ecommerce_location" placeholder="Ej: Caracas, Venezuela"/>
                        </setting>

                        <setting string="Políticas de Entrega y Envíos" help="Detalles sobre delivery, agencias de encomienda y retiros personales.">
                            <field name="ecommerce_delivery_info" placeholder="Ej: Envíos gratis a partir de $50. Entregas en 24h."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ecommerce_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes Tienda Web</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'ecommerce_agenda'}</field>
    </record>

</odoo>
